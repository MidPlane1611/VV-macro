-- Automatically begin recording as soon as the standalone script finishes loading.
local autoStartCallOK, autoStarted, autoStartError = pcall(Replay.Start)
if autoStartCallOK and autoStarted then
    print("Replay Standalone loaded: recording started automatically. Press F8 or use Stop to save. RightShift hides/shows the window.")
else
    local reason = autoStartCallOK and autoStartError or autoStarted
    warn("Replay Standalone: automatic recording could not start: " .. tostring(reason))
end
