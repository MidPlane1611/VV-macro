local function safeDisconnect(connection)
    if connection then
        pcall(function() connection:Disconnect() end)
    end
end

local function trim(value)
    return tostring(value or ""):gsub("^%s+", ""):gsub("%s+$", "")
end

local function formatBytes(bytes)
    bytes = tonumber(bytes) or 0
    if bytes < 1024 then
        return tostring(bytes) .. " B"
    elseif bytes < 1024 * 1024 then
        return string.format("%.1f KB", bytes / 1024)
    end
    return string.format("%.2f MB", bytes / (1024 * 1024))
end

local function ensureFolder()
    if type(makefolder) ~= "function" then
        return false
    end

    if type(isfolder) == "function" then
        local ok, exists = pcall(isfolder, ROOT_FOLDER)
        if ok and exists then
            return true
        end
    end

    local ok = pcall(makefolder, ROOT_FOLDER)
    return ok
end

local function getRoot()
    local character = LocalPlayer.Character
    if not character then
        return nil
    end
    return character:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    local character = LocalPlayer.Character
    if not character then
        return nil
    end
    return character:FindFirstChildOfClass("Humanoid")
end

function Replay.saveHistory()
    if type(writefile) ~= "function" then
        return false, "Executor file-writing API is unavailable. History is session-only."
    end

    ensureFolder()

    local historyToSave = {}
    for _, entry in ipairs(Replay.history) do
        local savedEntry = {}
        for key, value in pairs(entry) do
            if key ~= "_cachedCode" then
                savedEntry[key] = value
            end
        end
        table.insert(historyToSave, savedEntry)
    end

    local okEncode, encoded = pcall(function()
        return HttpService:JSONEncode(historyToSave)
    end)
    if not okEncode then
        return false, "Could not encode replay history: " .. tostring(encoded)
    end

    local okWrite, writeError = pcall(writefile, HISTORY_FILE, encoded)
    if not okWrite then
        return false, "Could not write replay history: " .. tostring(writeError)
    end

    return true, "Saved."
end

function Replay.loadHistory()
    if type(readfile) ~= "function" then
        return false, "Executor file-reading API is unavailable."
    end

    local okRead, raw = pcall(readfile, HISTORY_FILE)
    if not okRead or type(raw) ~= "string" or raw == "" then
        return false, "No saved replay history found."
    end

    local okDecode, decoded = pcall(function()
        return HttpService:JSONDecode(raw)
    end)
    if not okDecode or type(decoded) ~= "table" then
        return false, "Replay history file is invalid."
    end

    Replay.history = {}
    for _, entry in ipairs(decoded) do
        if type(entry) == "table" and type(entry.queue) == "table" then
            table.insert(Replay.history, entry)
        end
    end

    return true, "Loaded " .. tostring(#Replay.history) .. " replay(s)."
end

local function getRemotePath(remote)
    local segments = {}
    local current = remote

    while current and current ~= game do
        table.insert(segments, 1, current.Name)
        current = current.Parent
    end

    if current ~= game or #segments == 0 then
        return nil
    end

    return segments
end

local function serializeValue(value, depth, seen)
    depth = depth or 0
    seen = seen or {}

    if depth > 4 then
        return "nil --[[ SKIPPED: too deep ]]"
    end

    local valueType = typeof(value)

    if valueType == "nil" then
        return "nil"
    elseif valueType == "number" then
        if value ~= value then
            return "0/0"
        elseif value == math.huge then
            return "math.huge"
        elseif value == -math.huge then
            return "-math.huge"
        end
        return tostring(value)
    elseif valueType == "boolean" then
        return tostring(value)
    elseif valueType == "string" then
        return string.format("%q", value)
    elseif valueType == "Vector3" then
        return string.format("Vector3.new(%.6f, %.6f, %.6f)", value.X, value.Y, value.Z)
    elseif valueType == "Vector2" then
        return string.format("Vector2.new(%.6f, %.6f)", value.X, value.Y)
    elseif valueType == "CFrame" then
        local components = {value:GetComponents()}
        local formatted = {}
        for i, component in ipairs(components) do
            formatted[i] = string.format("%.6f", component)
        end
        return "CFrame.new(" .. table.concat(formatted, ", ") .. ")"
    elseif valueType == "Color3" then
        return string.format(
            "Color3.fromRGB(%d, %d, %d)",
            math.floor(value.R * 255 + 0.5),
            math.floor(value.G * 255 + 0.5),
            math.floor(value.B * 255 + 0.5)
        )
    elseif valueType == "EnumItem" then
        return "Enum." .. value.EnumType.Name .. "." .. value.Name
    elseif valueType == "table" then
        if seen[value] then
            return "nil --[[ SKIPPED: circular table ]]"
        end

        seen[value] = true
        local parts = {}
        local count = 0

        for key, childValue in pairs(value) do
            count = count + 1
            if count > 50 then
                table.insert(parts, "--[[ remaining table values skipped ]]")
                break
            end

            local keyType = typeof(key)
            local keyText
            if keyType == "string" then
                keyText = "[" .. string.format("%q", key) .. "]"
            elseif keyType == "number" then
                keyText = "[" .. tostring(key) .. "]"
            elseif keyType == "boolean" then
                keyText = "[" .. tostring(key) .. "]"
            else
                keyText = nil
            end

            if keyText then
                table.insert(parts, keyText .. " = " .. serializeValue(childValue, depth + 1, seen))
            end
        end

        seen[value] = nil
        return "{" .. table.concat(parts, ", ") .. "}"
    end

    return "nil --[[ SKIPPED: " .. tostring(valueType) .. " ]]"
end

local function makeRemoteCode(pathSegments, argsList)
    local pathParts = {}
    for _, segment in ipairs(pathSegments) do
        table.insert(pathParts, string.format("%q", segment))
    end

    local argumentParts = {}
    local hasSkipped = false
    for i = 1, argsList.n do
        local serialized = serializeValue(argsList[i])
        if serialized:find("SKIPPED", 1, true) then
            hasSkipped = true
        end
        table.insert(argumentParts, serialized)
    end

    local pathLiteral = "{" .. table.concat(pathParts, ", ") .. "}"
    local argsLiteral = "table.pack(" .. table.concat(argumentParts, ", ") .. ")"
    local comment = hasSkipped and " --[[ some arguments were skipped ]]" or ""

    return string.format([[
do
    local remotePath = %s
    local remote = game
    for _, childName in ipairs(remotePath) do
        remote = remote and remote:FindFirstChild(childName)
    end
    if remote and remote:IsA("RemoteEvent") then
        local args = %s
        local unpackArgs = table.unpack or unpack
        remote:FireServer(unpackArgs(args, 1, args.n))
    end
end%s]], pathLiteral, argsLiteral, comment)
end

function Replay.push(waitTime, kind, codeLine, x, y, z)
    if not Replay.recording then
        return false
    end

    if #Replay.queue >= Replay.maxEvents then
        if not Replay.limitStopQueued then
            Replay.limitStopQueued = true
            task.defer(function()
                if Replay.recording then
                    Replay.stopAndSave(true)
                end
            end)
        end
        return false
    end

    table.insert(Replay.queue, {
        wait = math.max(0, tonumber(waitTime) or 0),
        kind = kind,
        code = codeLine or "",
        targetX = x,
        targetY = y,
        targetZ = z,
    })

    return true
end

function Replay.generateCode(queueOverride, durationOverride)
    local queue = queueOverride or Replay.queue
    local duration = tonumber(durationOverride)
        or (Replay.startTime > 0 and (os.clock() - Replay.startTime) or 0)

    local lines = {
        "-- Replay generated by Replay Standalone",
        "-- Events: " .. tostring(#queue),
        "-- Duration: " .. string.format("%.1f", duration) .. " sec",
        "",
        "local Players = game:GetService(\"Players\")",
        "local LocalPlayer = Players.LocalPlayer",
        "local function getRoot()",
        "    local character = LocalPlayer.Character",
        "    if not character then return nil end",
        "    return character:FindFirstChild(\"HumanoidRootPart\")",
        "end",
        "local function getHum()",
        "    local character = LocalPlayer.Character",
        "    if not character then return nil end",
        "    return character:FindFirstChildOfClass(\"Humanoid\")",
        "end",
        "local hum = getHum()",
        "",
    }

    local firstPosition
    for _, item in ipairs(queue) do
        if (item.kind == "pos" or item.kind == "walk" or item.kind == "jump") and item.targetX ~= nil then
            firstPosition = item
            break
        end
    end

    if firstPosition then
        table.insert(lines, string.format([[
do
    local root = getRoot()
    if root then
        root.CFrame = CFrame.new(%.3f, %.3f, %.3f)
        root.AssemblyLinearVelocity = Vector3.zero
    end
end]], firstPosition.targetX, firstPosition.targetY, firstPosition.targetZ))
        table.insert(lines, "")
    end

    local previousWasPosition = false
    local index = 1

    while index <= #queue do
        local item = queue[index]

        if item.kind == "walk" and item.targetX ~= nil then
            local totalWait = tonumber(item.wait) or 0
            local lastWalk = item
            local nextIndex = index + 1

            while nextIndex <= #queue
                and queue[nextIndex].kind == "walk"
                and queue[nextIndex].targetX ~= nil do
                totalWait = totalWait + (tonumber(queue[nextIndex].wait) or 0)
                lastWalk = queue[nextIndex]
                nextIndex = nextIndex + 1
            end

            table.insert(lines, string.format(
                "do local h = getHum(); if h then h:MoveTo(Vector3.new(%.1f, %.1f, %.1f)) end end",
                lastWalk.targetX, lastWalk.targetY, lastWalk.targetZ
            ))
            table.insert(lines, string.format("task.wait(%.2f)", math.max(totalWait, 0.05)))
            previousWasPosition = true
            index = nextIndex

        elseif (item.kind == "jump" or item.kind == "pos") and item.targetX ~= nil then
            if not previousWasPosition and (tonumber(item.wait) or 0) > 0.01 then
                table.insert(lines, string.format("task.wait(%.2f)", item.wait))
            end

            local nextWait = 0.3
            if queue[index + 1] then
                nextWait = tonumber(queue[index + 1].wait) or nextWait
            end
            nextWait = math.max(nextWait, 0.15)

            table.insert(lines, string.format(
                "do local h = getHum(); if h then h:MoveTo(Vector3.new(%.1f, %.1f, %.1f)); if h.FloorMaterial ~= Enum.Material.Air then h:ChangeState(Enum.HumanoidStateType.Jumping) end end end",
                item.targetX, item.targetY, item.targetZ
            ))
            table.insert(lines, string.format("task.wait(%.2f)", nextWait))
            previousWasPosition = true
            index = index + 1

        else
            if not previousWasPosition and (tonumber(item.wait) or 0) > 0.01 then
                table.insert(lines, string.format("task.wait(%.2f)", item.wait))
            end
            if type(item.code) == "string" and item.code ~= "" then
                table.insert(lines, item.code)
            end
            previousWasPosition = false
            index = index + 1
        end
    end

    table.insert(lines, "")
    table.insert(lines, "-- Cleanup")
    table.insert(lines, "do local h = getHum(); if h then h.Jump = false; h:Move(Vector3.zero, false) end end")

    return table.concat(lines, "\n")
end

local function getMissingHookAPIs()
    local missing = {}
    if type(getrawmetatable) ~= "function" then
        table.insert(missing, "getrawmetatable")
    end
    if type(setreadonly) ~= "function" then
        table.insert(missing, "setreadonly")
    end
    if type(getnamecallmethod) ~= "function" then
        table.insert(missing, "getnamecallmethod")
    end
    if type(newcclosure) ~= "function" then
        table.insert(missing, "newcclosure")
    end
    return missing
end

function Replay.canHookRemote()
    local missing = getMissingHookAPIs()
    if #missing == 0 then
        return true, nil
    end
    return false, table.concat(missing, ", ")
end

function Replay.installRemoteHook()
    local supported, missing = Replay.canHookRemote()
    Replay.hookSupported = supported
    Replay.hookMissingInfo = missing

    if not supported then
        return false, "Missing executor APIs: " .. tostring(missing)
    end
    if Replay.hookInstalled then
        return true
    end

    local ok, hookError = pcall(function()
        local meta = getrawmetatable(game)
        if not meta then
            error("Could not get the game metatable")
        end

        local oldNamecall = meta.__namecall
        if type(oldNamecall) ~= "function" then
            error("Original __namecall is unavailable")
        end

        local wrapped = newcclosure(function(self, ...)
            local methodOK, methodName = pcall(getnamecallmethod)
            local argsList = table.pack(...)

            -- The original game call runs first; recorder errors cannot block it.
            local results = table.pack(oldNamecall(self, table.unpack(argsList, 1, argsList.n)))

            if methodOK and methodName == "FireServer" and Replay.recording then
                pcall(function()
                    if typeof(self) ~= "Instance" or not self:IsA("RemoteEvent") then
                        return
                    end
                    if Replay.recordMode == "movement" then
                        return
                    end

                    for _, ignoredName in ipairs(Replay.remoteBlacklist) do
                        if self.Name:lower() == tostring(ignoredName):lower() then
                            return
                        end
                    end

                    local pathSegments = getRemotePath(self)
                    if not pathSegments then
                        return
                    end

                    local now = os.clock()
                    local deltaTime = math.max(0, now - (Replay.lastEventTime or now))
                    Replay.lastEventTime = now

                    local remoteCode = makeRemoteCode(pathSegments, argsList)

                    if Replay.recordMode ~= "events" then
                        local root = getRoot()
                        if root then
                            local position = root.Position
                            Replay.push(deltaTime, "walk", "", position.X, position.Y, position.Z)
                            Replay.push(0.03, "remote", remoteCode)
                            Replay.lastEventTime = Replay.lastEventTime + 0.03
                        else
                            Replay.push(deltaTime, "remote", remoteCode)
                        end
                    else
                        Replay.push(deltaTime, "remote", remoteCode)
                    end

                    Replay.remoteHookCount = Replay.remoteHookCount + 1
                end)
            end

            return table.unpack(results, 1, results.n)
        end)

        setreadonly(meta, false)
        meta.__namecall = wrapped
        setreadonly(meta, true)

        Replay.hookOriginal = oldNamecall
        Replay.hookMetatable = meta
        Replay.hookWrapped = wrapped
        Replay.hookInstalled = true
    end)

    if not ok then
        Replay.hookSupported = false
        Replay.hookMissingInfo = tostring(hookError)
        return false, tostring(hookError)
    end

    return true
end

function Replay.removeRemoteHook()
    if Replay.hookInstalled and Replay.hookOriginal and Replay.hookMetatable
        and type(setreadonly) == "function" then
        pcall(function()
            setreadonly(Replay.hookMetatable, false)
            -- Do not overwrite a hook installed by another script after this one.
            if Replay.hookMetatable.__namecall == Replay.hookWrapped then
                Replay.hookMetatable.__namecall = Replay.hookOriginal
            end
            setreadonly(Replay.hookMetatable, true)
        end)
    end

    Replay.hookInstalled = false
    Replay.hookOriginal = nil
    Replay.hookMetatable = nil
    Replay.hookWrapped = nil
end

local function bindHumanoid(humanoid)
    safeDisconnect(Replay.connectionStateChanged)
    Replay.connectionStateChanged = nil

    if not humanoid or Replay.recordMode == "events" then
        return
    end

    Replay.connectionStateChanged = humanoid.StateChanged:Connect(function(_, newState)
        if not Replay.recording or newState ~= Enum.HumanoidStateType.Jumping then
            return
        end

        local now = os.clock()
        local deltaTime = math.max(0, now - Replay.lastEventTime)
        Replay.lastEventTime = now

        local root = getRoot()
        if root then
            local position = root.Position
            Replay.push(deltaTime, "jump", "", position.X, position.Y, position.Z)
        else
            local jumpCode = "do local h = getHum(); if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end end"
            Replay.push(deltaTime, "jump", jumpCode)
        end
    end)
end

local function create(className, properties, parent)
    local object = Instance.new(className)
    for key, value in pairs(properties or {}) do
        object[key] = value
    end
    if parent then
        object.Parent = parent
    end
    return object
end

local function addCorner(object, radius)
    create("UICorner", {CornerRadius = UDim.new(0, radius or 8)}, object)
end

local function addStroke(object, color, transparency)
    create("UIStroke", {
        Color = color or COLORS.Border,
        Thickness = 1,
        Transparency = transparency or 0,
    }, object)
end

local function makeLabel(parent, text, size, position, textSize, color, font)
    return create("TextLabel", {
        BackgroundTransparency = 1,
        Size = size,
        Position = position,
        Text = text or "",
        TextColor3 = color or COLORS.Text,
        TextSize = textSize or 12,
        Font = font or Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextWrapped = false,
    }, parent)
end

local function makeButton(parent, text, size, position, callback, color)
    local button = create("TextButton", {
        Size = size,
        Position = position,
        BackgroundColor3 = color or COLORS.Panel2,
        BorderSizePixel = 0,
        Text = text,
        TextColor3 = COLORS.Text,
        TextSize = 11,
        Font = Enum.Font.GothamMedium,
        AutoButtonColor = true,
        Active = true,
        Selectable = true,
    }, parent)
    addCorner(button, 7)
    button.Activated:Connect(function()
        if callback then
            local ok, err = pcall(callback)
            if not ok then
                warn("Replay Standalone button error: " .. tostring(err))
            end
        end
    end)
    return button
end

local function makeTextBox(parent, text, placeholder, size, position)
    local box = create("TextBox", {
        Size = size,
        Position = position,
        BackgroundColor3 = COLORS.Panel2,
        BorderSizePixel = 0,
        Text = text or "",
        PlaceholderText = placeholder or "",
        PlaceholderColor3 = COLORS.Muted,
        TextColor3 = COLORS.Text,
        TextSize = 11,
        Font = Enum.Font.Gotham,
        ClearTextOnFocus = false,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, parent)
    addCorner(box, 6)
    return box
end

local function makeDraggable(handle, target)
    local dragging = false
    local dragInput
    local dragStart
    local startPosition

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragInput = input
            dragStart = input.Position
            startPosition = target.Position
        end
    end)

    handle.InputEnded:Connect(function(input)
        if input == dragInput then
            dragging = false
            dragInput = nil
        end
    end)

    return UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            target.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)
end

local function setHidden(hidden)
    Replay.hidden = hidden == true
    if Replay.mainWindow then
        Replay.mainWindow.Visible = not Replay.hidden
    end
    if Replay.floatingButton then
        Replay.floatingButton.Visible = Replay.hidden
    end
end

local function clearContent()
    if not Replay.content then
        return
    end
    for _, child in ipairs(Replay.content:GetChildren()) do
        child:Destroy()
    end
    Replay.ui = {}
end

local function renderHome()
    clearContent()
    local content = Replay.content
    local width = content.AbsoluteSize.X
    if width <= 0 then
        width = 430
    end

    local statusText
    local statusColor
    if Replay.recording then
        statusText = "RECORDING  |  " .. tostring(#Replay.queue) .. " events"
        statusColor = COLORS.Red
    elseif Replay.hookSupported then
        statusText = "Ready  |  RemoteEvent capture available"
        statusColor = COLORS.Green
    else
        statusText = "Movement recording only  |  Remote hook unavailable"
        statusColor = COLORS.Yellow
    end

    local status = makeLabel(content, statusText, UDim2.new(1, -16, 0, 24), UDim2.fromOffset(8, 4), 10, statusColor, Enum.Font.GothamBold)
    Replay.ui.homeStatus = status

    makeLabel(content, "Stop key", UDim2.fromOffset(110, 20), UDim2.fromOffset(8, 38), 10, COLORS.Muted)
    local stopKeyBox = makeTextBox(content, Replay.stopKeyName, "F8", UDim2.fromOffset(90, 26), UDim2.fromOffset(118, 35))
    Replay.ui.stopKeyBox = stopKeyBox

    makeLabel(content, "Max minutes", UDim2.fromOffset(110, 20), UDim2.fromOffset(8, 72), 10, COLORS.Muted)
    local maxTimeBox = makeTextBox(content, tostring(Replay.maxMinutes), "60", UDim2.fromOffset(90, 26), UDim2.fromOffset(118, 69))
    Replay.ui.maxTimeBox = maxTimeBox

    makeLabel(content, "Update interval", UDim2.fromOffset(110, 20), UDim2.fromOffset(8, 106), 10, COLORS.Muted)
    local intervalBox = makeTextBox(content, tostring(Replay.updateInterval), "0.5", UDim2.fromOffset(90, 26), UDim2.fromOffset(118, 103))
    Replay.ui.intervalBox = intervalBox

    makeLabel(content, "Record mode", UDim2.fromOffset(110, 20), UDim2.fromOffset(8, 140), 10, COLORS.Muted)
    local modeNames = {
        all = "All: Movement + FireServer",
        events = "Events Only: FireServer",
        movement = "Movement Only",
