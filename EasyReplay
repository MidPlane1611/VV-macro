function Replay.render()
    if not Replay.content or not Replay.content.Parent then
        return
    end

    if Replay.recording then
        renderRecording()
    elseif Replay.viewMode == "history" then
        renderHistory()
    elseif Replay.viewMode == "code" then
        renderCode()
    elseif Replay.viewMode == "blacklist" then
        renderBlacklist()
    else
        renderHome()
    end
end

function Replay.start()
    if Replay.recording then
        return false, "A recording is already active."
    end

    Replay.queue = {}
    Replay.limitStopQueued = false
    Replay.recording = true
    Replay.startTime = os.clock()
    Replay.lastEventTime = os.clock()
    Replay.lastPosTime = 0
    Replay.lastCFrame = nil
    Replay.remoteHookCount = 0

    local hookOK, hookError = Replay.installRemoteHook()
    if not hookOK then
        Replay.recordMode = "movement"
        warn("Replay Standalone: RemoteEvent capture disabled: " .. tostring(hookError))
    elseif Replay.recordMode ~= "all" and Replay.recordMode ~= "events" and Replay.recordMode ~= "movement" then
        Replay.recordMode = "all"
    end

    local stopKey = Enum.KeyCode[string.upper(Replay.stopKeyName or "F8")]
    safeDisconnect(Replay.connectionInput)
    Replay.connectionInput = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if Replay.recording and not gameProcessed and stopKey and input.KeyCode == stopKey then
            Replay.stopAndSave(true)
        end
    end)

    safeDisconnect(Replay.connectionHeartbeat)
    Replay.connectionHeartbeat = RunService.Heartbeat:Connect(function()
        if not Replay.recording then
            return
        end

        local elapsed = os.clock() - Replay.startTime
        if elapsed >= Replay.maxMinutes * 60 then
            Replay.stopAndSave(true)
            return
        end

        if Replay.recordMode ~= "events" then
            local root = getRoot()
            if root then
                local currentCFrame = root.CFrame
                local shouldRecord = false

                if not Replay.lastCFrame then
                    shouldRecord = true
                else
                    local positionDelta = (currentCFrame.Position - Replay.lastCFrame.Position).Magnitude
                    local rotationDelta = (currentCFrame.LookVector - Replay.lastCFrame.LookVector).Magnitude
                    if positionDelta > 0.5 or rotationDelta > 0.1 then
                        shouldRecord = true
                    end
                end

                if shouldRecord and elapsed - Replay.lastPosTime >= Replay.updateInterval then
                    local now = os.clock()
                    local deltaTime = math.max(0, now - Replay.lastEventTime)
                    Replay.lastEventTime = now

                    local position = currentCFrame.Position
                    local humanoid = root.Parent and root.Parent:FindFirstChildOfClass("Humanoid")
                    local onGround = humanoid and humanoid.FloorMaterial ~= Enum.Material.Air
                    local kind = onGround and "walk" or "jump"

                    Replay.push(
                        deltaTime,
                        kind,
                        "",
                        math.floor(position.X * 10 + 0.5) / 10,
                        math.floor(position.Y * 10 + 0.5) / 10,
                        math.floor(position.Z * 10 + 0.5) / 10
                    )

                    Replay.lastCFrame = currentCFrame
                    Replay.lastPosTime = elapsed
                end
            end
        end

        local minutes = math.floor(elapsed / 60)
        local seconds = math.floor(elapsed % 60)
        if Replay.recTimeLabel then
            Replay.recTimeLabel.Text = string.format("%02d:%02d", minutes, seconds)
        end
        if Replay.ui.recordStatus and Replay.ui.recordStatus.Parent then
            Replay.ui.recordStatus.Text = string.format("Recording... %02d:%02d", minutes, seconds)
        end
        if Replay.ui.recordCount and Replay.ui.recordCount.Parent then
            Replay.ui.recordCount.Text = "Events: " .. tostring(#Replay.queue)
        end
    end)

    local humanoid = getHumanoid()
    if humanoid then
        bindHumanoid(humanoid)
    end

    safeDisconnect(Replay.connectionCharAdded)
    Replay.connectionCharAdded = LocalPlayer.CharacterAdded:Connect(function(character)
        local newHumanoid = character:WaitForChild("Humanoid", 5)
        if newHumanoid and Replay.recording then
            bindHumanoid(newHumanoid)
        end
    end)

    Replay.recBar.Visible = true
    if Replay.recTimeLabel then
        Replay.recTimeLabel.Text = "00:00"
    end
    if Replay.recDotPulse then
        Replay.recDotPulse:Play()
    end

    Replay.viewMode = "home"
    Replay.render()
    return true
end

function Replay.stopAndSave(openCodeViewer)
    if not Replay.recording then
        return false
    end

    Replay.recording = false
    safeDisconnect(Replay.connectionHeartbeat)
    safeDisconnect(Replay.connectionStateChanged)
    safeDisconnect(Replay.connectionCharAdded)
    safeDisconnect(Replay.connectionInput)
    Replay.connectionHeartbeat = nil
    Replay.connectionStateChanged = nil
    Replay.connectionCharAdded = nil
    Replay.connectionInput = nil

    Replay.removeRemoteHook()

    if Replay.recBar then
        Replay.recBar.Visible = false
    end
    if Replay.recDotPulse then
        pcall(function() Replay.recDotPulse:Cancel() end)
    end

    local queueSnapshot = {}
    for index, item in ipairs(Replay.queue) do
        queueSnapshot[index] = item
    end

    local queueSize = 0
    local sizeOk, encodedQueue = pcall(function()
        return HttpService:JSONEncode(queueSnapshot)
    end)
    if sizeOk and type(encodedQueue) == "string" then
        queueSize = #encodedQueue
    end

    local entry = {
        name = "Replay " .. os.date("%Y-%m-%d %H:%M:%S"),
        queue = queueSnapshot,
        codeSize = queueSize,
        timestamp = os.time(),
        events = #queueSnapshot,
        duration = Replay.startTime > 0 and (os.clock() - Replay.startTime) or 0,
    }

    table.insert(Replay.history, 1, entry)
    while #Replay.history > 50 do
        table.remove(Replay.history)
    end

    local saved, saveMessage = Replay.saveHistory()
    if not saved then
        warn("Replay Standalone: " .. tostring(saveMessage))
    end

    Replay.currentEntry = entry
    Replay.viewMode = openCodeViewer == false and "home" or "code"
    Replay.render()

    return true, entry
end

function Replay.Destroy()
    if Replay.destroyed then
        return
    end
    Replay.destroyed = true

    if Replay.recording then
        Replay.stopAndSave(false)
    else
        Replay.removeRemoteHook()
    end

    safeDisconnect(Replay.connectionHeartbeat)
    safeDisconnect(Replay.connectionStateChanged)
    safeDisconnect(Replay.connectionCharAdded)
    safeDisconnect(Replay.connectionInput)

    if Replay.recDotPulse then
        pcall(function() Replay.recDotPulse:Cancel() end)
    end
    for _, connection in ipairs(Replay.guiConnections) do
        safeDisconnect(connection)
    end
    Replay.guiConnections = {}
    if Replay.gui and Replay.gui.Parent then
        Replay.gui:Destroy()
    end

    if ENV.ReplayStandalone == Replay then
        ENV.ReplayStandalone = nil
    end
end

