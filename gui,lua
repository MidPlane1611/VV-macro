-- Функция для создания кнопок-переключателей (Toggle)
local function createToggle(name, defaultState, callback)
    local ToggleButton = Instance.new("TextButton")
    ToggleButton.Size = UDim2.new(1, 0, 0, 35)
    ToggleButton.BackgroundColor3 = currentTheme.Secondary
    ToggleButton.BorderSizePixel = 0
    ToggleButton.Text = "  " .. name .. ": " .. (defaultState and "ON" or "OFF")
    ToggleButton.TextColor3 = currentTheme.Text
    ToggleButton.TextSize = 14
    ToggleButton.Font = Enum.Font.SourceSansSemibold
    ToggleButton.TextXAlignment = Enum.TextXAlignment.Left
    ToggleButton.Parent = FunctionsContainer

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 8)
    Corner.Parent = ToggleButton

    local state = defaultState
    ToggleButton.MouseButton1Click:Connect(function()
        state = not state
        ToggleButton.Text = "  " .. name .. ": " .. (state and "ON" or "OFF")
        callback(state)
    end)
end

-- Счётчик FPS
if Settings.ShowFPS then
    local FpsLabel = Instance.new("TextLabel")
    FpsLabel.Size = UDim2.new(1, 0, 0, 35)
    FpsLabel.BackgroundColor3 = currentTheme.Secondary
    FpsLabel.BorderSizePixel = 0
    FpsLabel.TextColor3 = currentTheme.Accent
    FpsLabel.TextSize = 14
    FpsLabel.Font = Enum.Font.SourceSansBold
    FpsLabel.Text = "  FPS: calculating..."
    FpsLabel.Parent = FunctionsContainer
local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 8)
    Corner.Parent = FpsLabel

    task.spawn(function()
        local RunService = game:GetService("RunService")
        local lastUpdate = tick()
        local frames = 0
        RunService.RenderStepped:Connect(function()
            frames = frames + 1
            if tick() - lastUpdate >= 1 then
                FpsLabel.Text = "  FPS: " .. frames
                frames = 0
                lastUpdate = tick()
            end
        end)
    end)
end

-- Игровые функции (Kill Mobs, Gather, Kill Boss)
createToggle("Kill Mobs (Auto Farm)", false, function(state)
    if state then
        task.spawn(function()
            while task.wait(0.5) do
                local enemies = workspace:FindFirstChild("Enemies")
                if enemies then
                    for _, enemy in ipairs(enemies:GetChildren()) do
                        local human = enemy:FindFirstChildOfClass("Humanoid")
                        local root = enemy:FindFirstChild("HumanoidRootPart")
                        if human and human.Health > 0 and root then
                            print("Фарм моба:", enemy.Name)
                            break
                        end
                    end
                end
            end
        end)
    end
end)

createToggle("Gather Items", false, function(state)
    if state then
        task.spawn(function()
            while task.wait(1) do
                local items = workspace:FindFirstChild("Items")
                if items then
                    local player = game.Players.LocalPlayer
                    local char = player.Character
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        for _, item in ipairs(items:GetChildren()) do
                            if item:IsA("BasePart") then
                                char.HumanoidRootPart.CFrame = item.CFrame
                                task.wait(0.2)
                            end
                        end
                    end
                end
            end
        end)
    end
end)

createToggle("Kill Boss", false, function(state)
    if state then
        task.spawn(function()
            while task.wait(1) do
                local boss = workspace:FindFirstChild("Boss")
                if boss and boss:FindFirstChild("HumanoidRootPart") then
                    local human = boss:FindFirstChildOfClass("Humanoid")
                    if human and human.Health > 0 then
                        print("Босс обнаружен:", boss.Name)
                    end
                end
            end
        end)
    end
end)

-- Анимация открытия по центру экрана
local isOpen = false
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isOpen = not isOpen
        if isOpen then
            MainFrame:TweenSizeAndPosition(
                UDim2.new(0, 240, 0, 320),
                UDim2.new(0.5, -120, 0.5, -160), -- Центр экрана
                Enum.EasingDirection.Out, 
                Enum.EasingStyle.Quad, 
                0.3, true
            )
            FunctionsContainer.Visible = true
        else
            MainFrame:TweenSizeAndPosition(
                UDim2.new(0, 50, 0, 50),
                UDim2.new(1, -70, 0, 150), -- Возврат на исходное место
                Enum.EasingDirection.Out, 
                Enum.EasingStyle.Quad, 
                0.3, true
            )
            FunctionsContainer.Visible = false
        end
    end
end)
